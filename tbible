#!/usr/bin/env bash
#
# tbible - Terminal Bible (KJV)
# A fast, keyboard-driven KJV Bible browser and search tool built on fzf.

set -euo pipefail

VERSION="1.0.0"
DB_FILE="${DB_FILE:-$HOME/.local/share/terminal-bible/bible.db}"
TRANSLATION="${TRANSLATION:-KJV}"
SCRIPT_PATH="$(readlink -f "$0")"

# NT Books normalized list for OT/NT breakdown statistics
NT_BOOKS="'matthew','mark','luke','john','acts','romans','1corinthians','2corinthians','galatians','ephesians','philippians','colossians','1thessalonians','2thessalonians','1timothy','2timothy','titus','philemon','hebrews','james','1peter','2peter','1john','2john','3john','jude','revelation'"

# Help labels shown in the fzf headers
HELP_MAIN="enter: open chapter | tab: copy chapter | alt-s: global search | alt-p: toggle preview | alt-j/k: scroll"
HELP_VERSES="enter/tab: copy verse | esc: back | alt-p: toggle preview | alt-j/k: scroll"

usage() {
    cat <<EOF
tbible $VERSION - Terminal Bible (KJV)

A fast, keyboard-driven KJV Bible browser and search tool built on fzf.

Usage:
  tbible                 interactive browser
  tbible --help          show this help
  tbible --version       show version

Keybindings (interactive browser):
  type    a reference or search, e.g. "john 3", "john 3:16", or keywords
  enter   open chapter -> verse list (enter/tab copies verse)
  tab     copy chapter
  alt-s   global verse search
  alt-p   toggle preview | alt-j/alt-k scroll preview
  esc     back

Environment:
  DB_FILE       path to the SQLite database (see scripts/build_db.py)
  TRANSLATION   label used in copies and previews (default KJV)
EOF
}

# 1. Clipboard & Notification Helpers
copy_to_clipboard() {
    local data="$1"
    if command -v wl-copy &>/dev/null; then
        echo -n "$data" | wl-copy
    elif command -v xclip &>/dev/null; then
        echo -n "$data" | xclip -selection clipboard
    elif command -v xsel &>/dev/null; then
        echo -n "$data" | xsel --clipboard --input
    elif command -v pbcopy &>/dev/null; then
        echo -n "$data" | pbcopy
    fi
}

notify_copy() {
    local title="$1"
    if command -v notify-send &>/dev/null; then
        notify-send -a "Terminal Bible" "Copied to Clipboard" "$title" -t 2000
    fi
}

# 2. Query Builder for FTS Search
build_fts_query() {
    local clean_q
    clean_q=$(echo "$1" | sed 's/[^a-zA-Z0-9 ]//g' | xargs)
    [ -z "$clean_q" ] && return

    local prefix_q word_count
    prefix_q=$(echo "$clean_q" | awk '{for(i=1;i<=NF;i++) $i=$i"*"; print $0}')
    word_count=$(echo "$clean_q" | wc -w)

    if [ "$word_count" -gt 1 ]; then
        echo "\"$prefix_q\" OR ($prefix_q)"
    else
        echo "$prefix_q"
    fi
}

# 3. Unified Search Engine (DRY Architecture for Chapters and Verses)
search_engine() {
    local mode="$1"
    local q="$2"
    q=$(echo "$q" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [ -z "$q" ]; then
        if [ "$mode" = "chapters" ]; then
            echo "Browse All Chapters"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || char(9) || MAX(verse) FROM verses GROUP BY book, chapter;"
        else
            echo "Showing First 50 Verses"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || ':' || verse || ' | ' || text FROM verses LIMIT 50;"
        fi
        return
    fi

    # Verse Reference Match: "John 3:16"
    if [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local v="${BASH_REMATCH[3]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local res
        res=$(sqlite3 "$DB_FILE" "
            SELECT book || ' ' || chapter || ':' || verse || ' | ' || text
            FROM verses
            WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book'
              AND chapter = $ch AND verse = $v;
        " 2>/dev/null)
        if [ -n "$res" ]; then
            echo "Direct Verse Match"
            echo "$res"
            return
        fi
    fi

    # Chapter Reference Match: "John 3"
    if [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        if [ "$mode" = "chapters" ]; then
            local res
            res=$(sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || char(9) || MAX(verse)
                FROM verses
                WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book'
                  AND chapter = $ch
                GROUP BY book, chapter;
            " 2>/dev/null)
            if [ -n "$res" ]; then
                echo "Direct Chapter Match"
                echo "$res"
                return
            fi
        else
            local res
            res=$(sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || ':' || verse || ' | ' || text
                FROM verses
                WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book'
                  AND chapter = $ch
                ORDER BY verse;
            " 2>/dev/null)
            if [ -n "$res" ]; then
                local v_count
                v_count=$(echo "$res" | wc -l | xargs)
                echo "Chapter Verses Match ($v_count verses)"
                echo "$res"
                return
            fi
        fi
    fi

    # Book Match (Chapters mode only)
    if [ "$mode" = "chapters" ] && [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)$ ]]; then
        local norm_book
        norm_book=$(echo "$q" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local res
        res=$(sqlite3 "$DB_FILE" "
            SELECT book || ' ' || chapter || char(9) || MAX(verse)
            FROM verses
            WHERE REPLACE(LOWER(book), ' ', '') LIKE '$norm_book%'
            GROUP BY book, chapter;
        " 2>/dev/null)

        if [ -n "$res" ]; then
            local ch_count
            ch_count=$(echo "$res" | wc -l | xargs)
            echo "Book Match ($ch_count chapters)"
            echo "$res"
            return
        fi
    fi

    # FTS Keyword Search with Stats Header
    local fts_q
    fts_q=$(build_fts_query "$q")
    if [ -n "$fts_q" ]; then
        local stats
        stats=$(sqlite3 "$DB_FILE" "
            SELECT
                COUNT(*),
                COALESCE(SUM(CASE WHEN REPLACE(LOWER(book), ' ', '') IN ($NT_BOOKS) THEN 0 ELSE 1 END), 0),
                COALESCE(SUM(CASE WHEN REPLACE(LOWER(book), ' ', '') IN ($NT_BOOKS) THEN 1 ELSE 0 END), 0)
            FROM verses_fts
            WHERE verses_fts MATCH '$fts_q';
        " 2>/dev/null)

        local total ot nt
        total=$(echo "$stats" | cut -d'|' -f1)
        ot=$(echo "$stats" | cut -d'|' -f2)
        nt=$(echo "$stats" | cut -d'|' -f3)

        total=${total:-0}; ot=${ot:-0}; nt=${nt:-0}

        if [ "$total" -gt 200 ]; then
            echo "Top 200 of $total matches (OT: $ot | NT: $nt)"
        elif [ "$total" -gt 0 ]; then
            echo "Showing all $total matches (OT: $ot | NT: $nt)"
        else
            echo "No matches found"
        fi

        if [ "$mode" = "chapters" ]; then
            sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || char(9) || (
                    SELECT MAX(verse) FROM verses v WHERE v.book = f.book AND v.chapter = f.chapter
                )
                FROM verses_fts f
                WHERE verses_fts MATCH '$fts_q'
                GROUP BY book, chapter
                ORDER BY rank LIMIT 200;
            " 2>/dev/null
        else
            sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || ':' || verse || ' | ' || text
                FROM verses_fts
                WHERE verses_fts MATCH '$fts_q'
                ORDER BY rank LIMIT 200;
            " 2>/dev/null
        fi
    else
        echo "No matches found"
    fi
}

# 4. Universal Preview Renderer
get_preview() {
    local query="$1"
    local selection="$2"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" == *"|"* ]]; then
        # Single Verse Mode Preview
        local ref="${selection%%|*}"
        ref=$(echo "$ref" | xargs)

        if [[ "$ref" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local v="${BASH_REMATCH[3]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local text
            text=$(sqlite3 "$DB_FILE" "SELECT text FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch AND verse = $v;" 2>/dev/null)

            if [ -n "$text" ]; then
                echo -e "\033[1;34m- $ref [$TRANSLATION]\033[0m\n"
                printf "\033[1;33m%3s\033[0m %s\n\n" "$v" "$text"
            fi
        fi
    else
        # Full Chapter Mode Preview
        if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local raw_text
            raw_text=$(sqlite3 "$DB_FILE" "SELECT verse, text FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch ORDER BY verse;" 2>/dev/null)

            [ -z "$raw_text" ] && exit 0

            if [ -n "$query" ] && [[ ! "$query" =~ [0-9]+ ]]; then
                local safe_query
                safe_query=$(echo "$query" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
                echo "$raw_text" | awk -F'|' -v IGNORECASE=1 -v q="$safe_query" '
                {
                    verse_num = $1
                    text = $2
                    gsub(q, "\033[1;35m&\033[0m", text)
                    printf "\033[1;33m%3s\033[0m %s\n\n", verse_num, text
                }'
            else
                echo "$raw_text" | awk -F'|' '{printf "\033[1;33m%3s\033[0m %s\n\n", $1, $2}'
            fi
        fi
    fi
}

# 5. Universal Smart Copy
copy_smart() {
    local selection="$1"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" == *"|"* ]]; then
        # Copy Verse
        local ref="${selection%%|*}"
        ref=$(echo "$ref" | xargs)

        if [[ "$ref" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local v="${BASH_REMATCH[3]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local text
            text=$(sqlite3 "$DB_FILE" "SELECT text FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch AND verse = $v;" 2>/dev/null)

            if [ -n "$text" ]; then
                local content
                content=$(printf "%s (%s)\n----------------------------------------\n%s %s" "$ref" "$TRANSLATION" "$v" "$text")
                copy_to_clipboard "$content"
                notify_copy "$ref ($TRANSLATION)"
            fi
        fi
    else
        # Copy Chapter
        if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local raw_text
            raw_text=$(sqlite3 "$DB_FILE" "SELECT verse, text FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch ORDER BY verse;" 2>/dev/null)

            [ -z "$raw_text" ] && exit 0

            local content
            content=$(printf "%s (%s)\n----------------------------------------\n%s" \
                "$selection" "$TRANSLATION" \
                "$(echo "$raw_text" | awk -F'|' '{printf "%s %s\n\n", $1, $2}')")

            copy_to_clipboard "$content"
            notify_copy "$selection ($TRANSLATION)"
        fi
    fi
}

# 6. Drilled-Down Verse Selection View
select_verse_mode() {
    local selection="$1"
    local initial_query="$2"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local count
        count=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch;" 2>/dev/null)
        local label_text="$selection | $count verses"

        {
            echo "Viewing: $selection ($count verses)"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || ':' || verse || ' | ' || text FROM verses WHERE REPLACE(LOWER(book), ' ', '') = '$norm_book' AND chapter = $ch ORDER BY verse;"
        } | fzf --ansi \
            --layout=reverse \
            --info=hidden \
            --header-lines=1 \
            --query="$initial_query" \
            --prompt="Select Verse > " \
            --header="$HELP_VERSES" \
            --preview "$SCRIPT_PATH --get-preview '' {}" \
            --preview-window 'down:50%:wrap:border-rounded' \
            --preview-label="$label_text" \
            --preview-label-pos='top' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --bind "tab:execute-silent($SCRIPT_PATH --copy {})" \
            --bind "enter:execute-silent($SCRIPT_PATH --copy {})"
    fi
}

# 7. Global Verse Search Overlay
global_verse_search() {
    local initial_query="$1"

    search_engine "verses" "$initial_query" | fzf --ansi \
        --disabled \
        --layout=reverse \
        --info=hidden \
        --header-lines=1 \
        --query="$initial_query" \
        --bind "change:reload:$SCRIPT_PATH --search-verses {q}" \
        --prompt="Global Verse Search > " \
        --header="$HELP_VERSES" \
        --preview "$SCRIPT_PATH --get-preview {q} {}" \
        --preview-window 'down:50%:wrap:border-rounded' \
        --preview-label=' Verse Preview ' \
        --preview-label-pos='top' \
        --bind 'alt-p:toggle-preview' \
        --bind 'alt-k:preview-up,alt-j:preview-down' \
        --bind "tab:execute-silent($SCRIPT_PATH --copy {})" \
        --bind "enter:execute-silent($SCRIPT_PATH --copy {})"
}

# Sub-command Dispatcher
case "${1:-}" in
    --help|-h) usage ; exit 0 ;;
    --version|-V) echo "tbible $VERSION" ; exit 0 ;;
    --search-chapters) shift; search_engine "chapters" "$@" ; exit 0 ;;
    --search-verses) shift; search_engine "verses" "$@" ; exit 0 ;;
    --get-preview) shift; get_preview "$@" ; exit 0 ;;
    --copy) shift; copy_smart "$@" ; exit 0 ;;
    --select-verse-mode) shift; select_verse_mode "$@" ; exit 0 ;;
    --global-verse-search) shift; global_verse_search "$@" ; exit 0 ;;
    "") usage ; exit 0 ;;
esac

# Main Execution Loop
search_engine "chapters" "" | fzf \
    --ansi \
    --disabled \
    --layout=reverse \
    --info=hidden \
    --delimiter='\t' \
    --with-nth=1 \
    --header-lines=1 \
    --header="$HELP_MAIN" \
    --bind "change:reload:$SCRIPT_PATH --search-chapters {q}" \
    --preview "$SCRIPT_PATH --get-preview {q} {1}" \
    --preview-window 'down:65%:wrap:border-rounded' \
    --preview-label=' {1} ({2} verses) ' \
    --preview-label-pos='top' \
    --bind 'alt-p:toggle-preview' \
    --bind 'alt-k:preview-up,alt-j:preview-down' \
    --bind "tab:execute-silent($SCRIPT_PATH --copy {1})" \
    --bind "enter:execute($SCRIPT_PATH --select-verse-mode {1} {q})" \
    --bind "alt-s:execute($SCRIPT_PATH --global-verse-search {q})" \
    --prompt='Bible Search > '