#!/usr/bin/env bash
#
# tbible - Terminal Bible (KJV)
# A fast, keyboard-driven KJV Bible browser and search tool built on fzf.

VERSION="1.0.0"
DB_FILE="${DB_FILE:-$HOME/.local/share/terminal-bible/bible.db}"
TRANSLATION="${TRANSLATION:-KJV}"
SCRIPT_PATH="$(readlink -f "$0")"

# NT Books normalized list for OT/NT breakdown statistics
NT_BOOKS="'matthew','mark','luke','john','acts','romans','1corinthians','2corinthians','galatians','ephesians','philippians','colossians','1thessalonians','2thessalonians','1timothy','2timothy','titus','philemon','hebrews','james','1peter','2peter','1john','2john','3john','jude','revelation'"

# Search guidance sits below the input; search help separates the results and
# preview, with reading controls below the preview.
HELP_SEARCH="Type a book/chapter, verse reference, or words to search"
HELP_MAIN_RESULTS="↑/↓ move | Enter open | Alt-s verse search | Alt-p preview"
HELP_READING="Alt-j/k scroll | Alt-u/d page | Tab copy chapter"
HELP_VERSE_RESULTS="↑/↓ move | Enter/Tab copy verse | Esc back | Alt-p preview"
HELP_VERSE_PREVIEW="Alt-j/k scroll | Alt-u/d page"
HELP_GLOBAL_RESULTS="↑/↓ move | Enter/Tab copy verse | Esc back | Alt-p preview"
HELP_GLOBAL_PREVIEW="Alt-j/k scroll | Alt-u/d page"

usage() {
    cat <<EOF
tbible $VERSION - Terminal Bible (KJV)

A fast, keyboard-driven KJV Bible browser and search tool built on fzf.

Usage:
  tbible                 interactive browser
  tbible --help          show this help
  tbible --version       show version

Keybindings (interactive browser):
  type    a reference or search, e.g. "john 3", "john 3:16", or keywords
  enter   open chapter -> verse list (enter/tab copies verse)
  tab     copy chapter
  ctrl-j/k or arrows  move through results
  alt-s   verse search across the whole Bible
  alt-j/k scroll preview | alt-u/d scroll by half-page
  alt-p   toggle preview
  esc     back

Environment:
  DB_FILE       path to the SQLite database (see scripts/build_db.py)
  TRANSLATION   label used in copies and previews (default KJV)
EOF
}

# 1. Clipboard & Notification Helpers
copy_to_clipboard() {
    local data="$1"
    if command -v wl-copy &>/dev/null; then
        echo -n "$data" | wl-copy
    elif command -v xclip &>/dev/null; then
        echo -n "$data" | xclip -selection clipboard
    elif command -v xsel &>/dev/null; then
        echo -n "$data" | xsel --clipboard --input
    elif command -v pbcopy &>/dev/null; then
        echo -n "$data" | pbcopy
    fi
}

notify_copy() {
    local title="$1"
    if command -v notify-send &>/dev/null; then
        notify-send -a "Terminal Bible" "Copied to Clipboard" "$title" -t 2000
    fi
}

# Resolve the best verse to lead with for a given chapter+query, plus the
# chapter's verse total. Returns "start_verse<TAB>chapter_total", where
# start_verse leaves 3 verses of context above the match. Empty if no jump
# should be applied (reference-shaped query, book-prefix query, empty FTS
# query, or no match in that chapter).
resolve_jump_verse() {
    local query="$1"
    local norm_book="$2"
    local chapter="$3"

    [ -z "$query" ] && return
    [[ "$chapter" =~ ^[0-9]+$ ]] || return

    # Skip reference-shaped queries (e.g. "john 3", "john 3:16")
    if [[ "$query" =~ ^[1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*[[:space:]]+[0-9]+(:[0-9]+)?$ ]]; then
        return
    fi

    local fts_q
    fts_q=$(build_fts_query "$query")
    [ -z "$fts_q" ] && return

    # Skip book-prefix queries (e.g. "gen", "rom") - the Book Match branch
    # should take precedence and not jump.
    local norm_query
    norm_query=$(echo "$query" | tr -d ' ' | tr '[:upper:]' '[:lower:]')
    if [ -n "$norm_query" ]; then
        local book_prefix_count
        book_prefix_count=$(sqlite3 "$DB_FILE" "SELECT COUNT(DISTINCT book) FROM verses WHERE book_key LIKE '$norm_query%';" 2>/dev/null)
        [ "$book_prefix_count" -gt 0 ] 2>/dev/null && return
    fi

    local res
    res=$(sqlite3 "$DB_FILE" "
        SELECT COALESCE((SELECT v.verse
                         FROM verses_fts f
                         JOIN verses v ON v.rowid = f.rowid
                         WHERE verses_fts MATCH 'text : ($fts_q)'
                           AND v.book_key = '$norm_book'
                           AND v.chapter = $chapter
                         ORDER BY rank LIMIT 1), 0)
               || char(9) ||
               (SELECT MAX(verse) FROM verses WHERE book_key = '$norm_book' AND chapter = $chapter);
    " 2>/dev/null)

    [ -z "$res" ] && return
    local best_total best vtotal start_v
    best_total=$(echo "$res" | cut -f1)
    vtotal=$(echo "$res" | cut -f2)
    best="${best_total:-0}"
    vtotal="${vtotal:-0}"
    if [ "${best:-0}" -le 0 ] 2>/dev/null; then
        return
    fi
    if [ "${vtotal:-0}" -le 0 ] 2>/dev/null; then
        return
    fi
    start_v=$(( best > 3 ? best - 3 : 1 ))
    printf '%s	%s' "$start_v" "$vtotal"
}

# 2. Query Builder for FTS Search
build_fts_query() {
    local clean_q
    clean_q=$(sanitize_query "$1")
    [ -z "$clean_q" ] && return

    local prefix_q word_count
    prefix_q=$(echo "$clean_q" | awk '{for(i=1;i<=NF;i++) $i=$i"*"; print $0}')
    word_count=$(echo "$clean_q" | wc -w)

    if [ "$word_count" -gt 1 ]; then
        echo "\"$prefix_q\" OR ($prefix_q)"
    else
        echo "$prefix_q"
    fi
}

# Strip everything except alphanumerics and spaces, then collapse whitespace.
# Single source of truth for both the FTS query and the preview highlighter.
sanitize_query() {
    echo "$1" | sed 's/[^a-zA-Z0-9 ]//g' | xargs
}

# Space-separated highlight tokens, no prefix stars and no FTS quoting.
# Tokens are alnum-only by the time they reach here, so they are safe to embed
# in an awk regex without further escaping.
build_highlight_terms() {
    local clean_q
    clean_q=$(sanitize_query "$1")
    [ -z "$clean_q" ] && return
    echo "$clean_q"
}

# 3. Unified Search Engine (DRY Architecture for Chapters and Verses)
search_engine() {
    local mode="$1"
    local q="${2:-}"
    q=$(echo "$q" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [ -z "$q" ]; then
        if [ "$mode" = "chapters" ]; then
            echo "Browse All Chapters"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || char(9) || MAX(verse) || char(9) || 0 FROM verses GROUP BY book, chapter;"
        else
            echo "Showing First 50 Verses"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || ':' || verse || ' | ' || text FROM verses LIMIT 50;"
        fi
        return
    fi

    # Verse Reference Match: "John 3:16"
    if [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local v="${BASH_REMATCH[3]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local res
        res=$(sqlite3 "$DB_FILE" "
            SELECT book || ' ' || chapter || ':' || verse || ' | ' || text
            FROM verses
            WHERE book_key = '$norm_book'
              AND chapter = $ch AND verse = $v;
        " 2>/dev/null)
        if [ -n "$res" ]; then
            echo "Direct Verse Match"
            echo "$res"
            return
        fi
    fi

    # Chapter Reference Match: "John 3"
    if [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        if [ "$mode" = "chapters" ]; then
            local res
            res=$(sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || char(9) || MAX(verse) || char(9) || 0
                FROM verses
                WHERE book_key = '$norm_book'
                  AND chapter = $ch
                GROUP BY book, chapter;
            " 2>/dev/null)
            if [ -n "$res" ]; then
                echo "Direct Chapter Match"
                echo "$res"
                return
            fi
        else
            local res
            res=$(sqlite3 "$DB_FILE" "
                SELECT book || ' ' || chapter || ':' || verse || ' | ' || text
                FROM verses
                WHERE book_key = '$norm_book'
                  AND chapter = $ch
                ORDER BY verse;
            " 2>/dev/null)
            if [ -n "$res" ]; then
                local v_count
                v_count=$(echo "$res" | wc -l | xargs)
                echo "Chapter Verses Match ($v_count verses)"
                echo "$res"
                return
            fi
        fi
    fi

    # Book Match (Chapters mode only)
    if [ "$mode" = "chapters" ] && [[ "$q" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)$ ]]; then
        local norm_book
        norm_book=$(echo "$q" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local res
        # book_key and norm_book are both lowercased, so case-sensitive LIKE is
        # safe here and lets the prefix use idx_verses_bkc as a range seek.
        res=$(sqlite3 "$DB_FILE" "
            PRAGMA case_sensitive_like=ON;
            SELECT book || ' ' || chapter || char(9) || MAX(verse) || char(9) || 0
            FROM verses
            WHERE book_key LIKE '$norm_book%'
            GROUP BY book, chapter;
        " 2>/dev/null)

        if [ -n "$res" ]; then
            local ch_count
            ch_count=$(echo "$res" | wc -l | xargs)
            echo "Book Match ($ch_count chapters)"
            echo "$res"
            return
        fi
    fi

    # FTS Keyword Search with Stats Header
    local fts_q
    fts_q=$(build_fts_query "$q")
    if [ -n "$fts_q" ]; then
        local text_fts_q="text : ($fts_q)"
        local stats
        stats=$(sqlite3 "$DB_FILE" "
            SELECT
                COUNT(*),
                COALESCE(SUM(CASE WHEN REPLACE(LOWER(book), ' ', '') IN ($NT_BOOKS) THEN 0 ELSE 1 END), 0),
                COALESCE(SUM(CASE WHEN REPLACE(LOWER(book), ' ', '') IN ($NT_BOOKS) THEN 1 ELSE 0 END), 0)
            FROM verses_fts
            WHERE verses_fts MATCH '$text_fts_q';
        " 2>/dev/null)

        local total ot nt
        total=$(echo "$stats" | cut -d'|' -f1)
        ot=$(echo "$stats" | cut -d'|' -f2)
        nt=$(echo "$stats" | cut -d'|' -f3)

        total=${total:-0}; ot=${ot:-0}; nt=${nt:-0}

        if [ "$total" -gt 200 ]; then
            echo "Top 200 of $total matches (OT: $ot | NT: $nt)"
        elif [ "$total" -gt 0 ]; then
            echo "Showing all $total matches (OT: $ot | NT: $nt)"
        else
            echo "No matches found"
        fi

        if [ "$mode" = "chapters" ]; then
            # The per-chapter verse count comes from a single grouped pass over
            # the covering index rather than a correlated subquery per group.
            # The best matching verse per chapter is resolved once in its own
            # CTE (joining it in the SELECT list would re-run FTS per group and
            # costs ~4s instead of ~120ms).
            # Field 3 is a hidden preview scroll offset: verse number + 2 header
            # lines, clamped to 0 when the match sits in the first 3 verses.
            sqlite3 "$DB_FILE" "
                WITH ch AS (
                    SELECT book, chapter, MAX(verse) AS mv
                    FROM verses GROUP BY book, chapter
                ),
                best AS (
                    SELECT book, chapter, verse,
                           ROW_NUMBER() OVER (PARTITION BY book, chapter ORDER BY rank) AS rn
                    FROM verses_fts
                    WHERE verses_fts MATCH 'text : ($fts_q)'
                ),
                m AS (
                    SELECT f.book AS book, f.chapter AS chapter, MIN(rank) AS r
                    FROM verses_fts f
                    JOIN verses v ON v.rowid = f.rowid
                    JOIN ch ON ch.book = f.book AND ch.chapter = f.chapter
                    WHERE verses_fts MATCH '$text_fts_q'
                    GROUP BY f.book, f.chapter
                    ORDER BY r LIMIT 200
                )
                SELECT m.book || ' ' || m.chapter || char(9) || ch.mv || char(9) ||
                       CASE WHEN best.verse >= 4 THEN best.verse - 2 ELSE 0 END
                FROM m
                JOIN ch ON ch.book = m.book AND ch.chapter = m.chapter
                LEFT JOIN best ON best.book = m.book AND best.chapter = m.chapter AND best.rn = 1;
            " 2>/dev/null
        else
            sqlite3 "$DB_FILE" "
                SELECT v.book || ' ' || v.chapter || ':' || v.verse || ' | ' || v.text
                FROM verses_fts f
                JOIN verses v ON v.rowid = f.rowid
                WHERE verses_fts MATCH '$text_fts_q'
                ORDER BY rank LIMIT 200;
            " 2>/dev/null
        fi
    else
        echo "No matches found"
    fi
}

# Render one logical line per verse. Visual word wrap is left to fzf's
# wrap-word flag: fzf's wrapping is display-only and does not add logical
# lines, which keeps the fzf scroll offset (verse number + header) exact at
# any terminal width.
#
# Each token is matched at a word boundary with a trailing word-char run, so
# "faith" highlights the whole of "faithful" rather than a 5-char stub. When
# any token matches, that verse's number is printed in the same magenta used
# for the term hits so the matched verse is identifiable even when the term
# itself only appears as part of a longer word.
format_preview_verses() {
    local raw_text="$1"
    local query="${2:-}"
    local terms=""

    if [ -n "$query" ] && [[ ! "$query" =~ [0-9]+ ]]; then
        terms=$(build_highlight_terms "$query")
    fi

    printf '%s\n' "$raw_text" | awk -F'|' \
        -v IGNORECASE=1 \
        -v terms="$terms" '
        BEGIN {
            MAGENTA = "\033[1;35m"
            YELLOW  = "\033[1;33m"
            RESET   = "\033[0m"
            nterms = split(terms, toks, /[[:space:]]+/)
        }
        {
            verse_num = $1
            text = $2
            sub(/^[[:space:]]+/, "", text)

            matched = 0
            for (t = 1; t <= nterms; t++) {
                tok = toks[t]
                if (tok == "") continue
                hits = gsub("\\y" tok "[A-Za-z'"'"']*", MAGENTA "&" RESET, text)
                if (hits > 0) matched = 1
            }

            numcolor = matched ? MAGENTA : YELLOW
            printf "%s%3s%s %s\n", numcolor, verse_num, RESET, text
        }'
}

# 4. Universal Preview Renderer
get_preview() {
    local query="${1:-}"
    local selection="${2:-}"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" == *"|"* ]]; then
        # Single Verse Mode Preview
        local ref="${selection%%|*}"
        ref=$(echo "$ref" | xargs)

        if [[ "$ref" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local v="${BASH_REMATCH[3]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local text
            text=$(sqlite3 "$DB_FILE" "SELECT text FROM verses WHERE book_key = '$norm_book' AND chapter = $ch AND verse = $v;" 2>/dev/null)

            if [ -n "$text" ]; then
                local raw_text
                raw_text=$(printf '%s|%s' "$v" "$text")
                echo -e "\033[1;34m- $ref [$TRANSLATION]\033[0m\n"
                format_preview_verses "$raw_text" "$query"
            fi
        fi
    else
        # Full Chapter Mode Preview
        if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local start_v=1
            local verse_count=0
            local jump_info
            jump_info=$(resolve_jump_verse "$query" "$norm_book" "$ch")
            if [ -n "$jump_info" ]; then
                start_v=$(printf '%s' "$jump_info" | cut -f1)
                verse_count=$(printf '%s' "$jump_info" | cut -f2)
                [[ "$start_v" =~ ^[0-9]+$ ]] || start_v=1
                [[ "$verse_count" =~ ^[0-9]+$ ]] || verse_count=0
            fi

            local raw_text
            raw_text=$(sqlite3 "$DB_FILE" "SELECT verse, text FROM verses WHERE book_key = '$norm_book' AND chapter = $ch ORDER BY verse;" 2>/dev/null)
            [ -z "$raw_text" ] && exit 0
            if [ "${verse_count:-0}" -le 0 ] 2>/dev/null; then
                verse_count=$(printf '%s' "$raw_text" | awk 'END{print NR}')
            fi
            if [ "$start_v" -gt 1 ]; then
                printf "\033[1;34m- %s (%s verses) [%s] · from v%s\033[0m\n\n" \
                    "$selection" "$verse_count" "$TRANSLATION" "$start_v"
            else
                printf "\033[1;34m- %s (%s verses) [%s]\033[0m\n\n" \
                    "$selection" "$verse_count" "$TRANSLATION"
            fi
            format_preview_verses "$raw_text" "$query"
        fi
    fi
}

# 5. Universal Smart Copy
center_help() {
    local text="$1"
    local columns="${COLUMNS:-80}"
    local terminal_size

    terminal_size=$(stty size </dev/tty 2>/dev/null) || terminal_size=""
    if [[ "$terminal_size" =~ ^[0-9]+[[:space:]]+([0-9]+)$ ]]; then
        columns="${BASH_REMATCH[1]}"
    fi
    [[ "$columns" =~ ^[0-9]+$ ]] || columns=80

    local padding=$(((columns - ${#text}) / 2))
    [ "$padding" -ge 0 ] || padding=0
    printf '%*s%s\n' "$padding" "" "$text"
}

copy_smart() {
    local selection="$1"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" == *"|"* ]]; then
        # Copy Verse
        local ref="${selection%%|*}"
        ref=$(echo "$ref" | xargs)

        if [[ "$ref" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+):([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local v="${BASH_REMATCH[3]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local text
            text=$(sqlite3 "$DB_FILE" "SELECT text FROM verses WHERE book_key = '$norm_book' AND chapter = $ch AND verse = $v;" 2>/dev/null)

            if [ -n "$text" ]; then
                local content
                content=$(printf "%s (%s)\n----------------------------------------\n%s %s" "$ref" "$TRANSLATION" "$v" "$text")
                copy_to_clipboard "$content"
                notify_copy "$ref ($TRANSLATION)"
            fi
        fi
    else
        # Copy Chapter
        if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
            local raw_book="${BASH_REMATCH[1]}"
            local ch="${BASH_REMATCH[2]}"
            local norm_book
            norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

            local raw_text
            raw_text=$(sqlite3 "$DB_FILE" "SELECT verse, text FROM verses WHERE book_key = '$norm_book' AND chapter = $ch ORDER BY verse;" 2>/dev/null)

            [ -z "$raw_text" ] && exit 0

            local content
            content=$(printf "%s (%s)\n----------------------------------------\n%s" \
                "$selection" "$TRANSLATION" \
                "$(echo "$raw_text" | awk -F'|' '{printf "%s %s\n\n", $1, $2}')")

            copy_to_clipboard "$content"
            notify_copy "$selection ($TRANSLATION)"
        fi
    fi
}

# 6. Drilled-Down Verse Selection View
select_verse_mode() {
    local selection="$1"
    local initial_query="${2:-}"
    [ -z "$selection" ] && exit 0

    if [[ "$selection" =~ ^([1-3]?[[:space:]]*[A-Za-z]+[A-Za-z[[:space:]]]*)[[:space:]]+([0-9]+)$ ]]; then
        local raw_book="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local norm_book
        norm_book=$(echo "$raw_book" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

        local count
        count=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM verses WHERE book_key = '$norm_book' AND chapter = $ch;" 2>/dev/null)

        {
            echo "Viewing: $selection ($count verses)"
            sqlite3 "$DB_FILE" "SELECT book || ' ' || chapter || ':' || verse || ' | ' || text FROM verses WHERE book_key = '$norm_book' AND chapter = $ch ORDER BY verse;"
        } | fzf --ansi \
            --layout=reverse \
            --info=hidden \
            --header-lines=1 \
            --query="$initial_query" \
            --prompt="Select Verse > " \
            --input-border=rounded \
            --input-label="$HELP_SEARCH" \
            --input-label-pos=0:bottom \
            --footer="$("$SCRIPT_PATH" --center-help "$HELP_VERSE_RESULTS")" \
            --footer-border=none \
            --bind "resize:transform-footer:$SCRIPT_PATH --center-help '$HELP_VERSE_RESULTS'" \
            --preview "$SCRIPT_PATH --get-preview '' {}" \
            --preview-window 'down:11:wrap-word:noinfo:border-rounded' \
            --preview-label="$HELP_VERSE_PREVIEW" \
            --preview-label-pos=0:bottom \
            --bind 'alt-p:toggle-preview' \
            --bind 'ctrl-j:down,ctrl-k:up,alt-j:preview-down,alt-k:preview-up,alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind "tab:execute-silent($SCRIPT_PATH --copy {})" \
            --bind "enter:execute-silent($SCRIPT_PATH --copy {})"
    fi
}

# 7. Global Verse Search Overlay
global_verse_search() {
    local initial_query="${1:-}"

    search_engine "verses" "$initial_query" | fzf --ansi \
        --disabled \
        --layout=reverse \
        --info=hidden \
        --header-lines=1 \
        --query="$initial_query" \
        --bind "change:reload:$SCRIPT_PATH --search-verses {q}" \
        --prompt="Global Verse Search > " \
        --input-border=rounded \
        --input-label="$HELP_SEARCH" \
        --input-label-pos=0:bottom \
        --footer="$("$SCRIPT_PATH" --center-help "$HELP_GLOBAL_RESULTS")" \
        --footer-border=none \
        --bind "resize:transform-footer:$SCRIPT_PATH --center-help '$HELP_GLOBAL_RESULTS'" \
        --preview "$SCRIPT_PATH --get-preview {q} {}" \
        --preview-window 'down:11:wrap-word:noinfo:border-rounded' \
        --preview-label="$HELP_GLOBAL_PREVIEW" \
        --preview-label-pos=0:bottom \
        --bind 'alt-p:toggle-preview' \
        --bind 'ctrl-j:down,ctrl-k:up,alt-j:preview-down,alt-k:preview-up,alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --bind "tab:execute-silent($SCRIPT_PATH --copy {})" \
        --bind "enter:execute-silent($SCRIPT_PATH --copy {})"
}

# Sub-command Dispatcher
case "${1:-}" in
    --help|-h) usage ; exit 0 ;;
    --version|-V) echo "tbible $VERSION" ; exit 0 ;;
    --search-chapters) shift; search_engine "chapters" "$@" ; exit 0 ;;
    --search-verses) shift; search_engine "verses" "$@" ; exit 0 ;;
    --get-preview) shift; get_preview "$@" ; exit 0 ;;
    --center-help) shift; center_help "$@" ; exit 0 ;;
    --copy) shift; copy_smart "$@" ; exit 0 ;;
    --select-verse-mode) shift; select_verse_mode "$@" ; exit 0 ;;
    --global-verse-search) shift; global_verse_search "$@" ; exit 0 ;;
esac

# Main Execution Loop
#
# Chapters-mode preview scrolling:
#   wrap-word  fzf word-wraps for display only; it does not add logical lines,
#              so the scroll offset stays exact at any terminal width.
#   ~2         pins the 2-line header (title + blank) so the "· from vN" suffix
#              stays visible while scrolled into the chapter.
#   +{3}+2     field 3 is a logical-line offset (verse number + 2 header lines,
#              already reduced by 2 in SQL); the trailing +2 compensates for
#              the pinned header, so verse N lands with 3 verses of lead-in.
search_engine "chapters" "" | fzf \
    --ansi \
    --disabled \
    --layout=reverse \
    --info=hidden \
    --delimiter='\t' \
    --with-nth=1 \
    --header-lines=1 \
    --bind "change:reload:$SCRIPT_PATH --search-chapters {q}" \
    --preview "$SCRIPT_PATH --get-preview {q} {1}" \
    --preview-window 'down:62%:wrap-word:noinfo:border-rounded,~2,+{3}+2' \
    --preview-label="$HELP_READING" \
    --preview-label-pos=0:bottom \
    --footer="$("$SCRIPT_PATH" --center-help "$HELP_MAIN_RESULTS")" \
    --footer-border=none \
    --bind "resize:transform-footer:$SCRIPT_PATH --center-help '$HELP_MAIN_RESULTS'" \
    --input-border=rounded \
    --input-label="$HELP_SEARCH" \
    --input-label-pos=0:bottom \
    --bind 'alt-p:toggle-preview' \
    --bind 'ctrl-j:down,ctrl-k:up,alt-j:preview-down,alt-k:preview-up,alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
    --bind "tab:execute-silent($SCRIPT_PATH --copy {1})" \
    --bind "enter:execute($SCRIPT_PATH --select-verse-mode {1} {q})" \
    --bind "alt-s:execute($SCRIPT_PATH --global-verse-search {q})" \
    --prompt='Bible Search > '